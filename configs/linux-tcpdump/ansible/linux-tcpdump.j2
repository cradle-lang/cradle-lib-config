    - name: Copy tcpdump script
      become: yes
      copy:
        content: |+
          #!/bin/bash

          mkdir -p "/home/vagrant/network"

          while true; do
              TIMESTAMP=$(date +"%s")

              # Save to new pcap file after every 30 seconds
              timeout 30 tcpdump -i any -tttt -nn -w "/home/vagrant/capture.pcap"

             mv "/home/vagrant/capture.pcap" "/home/vagrant/network/capture_${TIMESTAMP}.pcap"

          done

        dest: /etc/systemd/system/linux_tcpdump.sh
        mode: "0771"

    - name: Copy tcpdump service
      become: yes
      copy:
        content: |+
          [Unit]
          Description=Network Monitoring
          After=network.target

          [Service]
          Type=simple
          User=root
          ExecStart=/etc/systemd/system/linux_tcpdump.sh
          ExecStop=/bin/kill $MAINPID
          Restart=always

          [Install]
          WantedBy=multi-user.target
        dest: /etc/systemd/system/tcpdump.service

    - name: Configure tcpdump capture paths
      become: yes
      replace:
        path: /etc/systemd/system/linux_tcpdump.sh
        regexp: '/home/[^/"]+'
        replace: '{{ linux_guest_home_dir }}'

    - name: Start tcpdump service
      become: yes
      service:
        name: tcpdump
        daemon_reload: yes
        state: started
        enabled: yes
